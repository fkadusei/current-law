---
import ChatWidget from "../components/ChatWidget.astro";
const { title, kind, description = "Every US federal law since 1973: what it does, who voted for it, and who signed it." } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const path = Astro.url.pathname.replace(base, "") || "/";
const nav = [
  ["/", "Laws"],
  ["/politicians/", "Politicians"],
  ["/presidents/", "Presidents"],
  ["/executive-orders/", "Executive orders"],
  ["/calendar/", "Calendar"],
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <script is:inline>
    // Apply the saved theme before the page paints, to avoid a flash.
    try { const t = localStorage.getItem("theme"); if (t === "light" || t === "dark") document.documentElement.dataset.theme = t; } catch (e) {}
  </script>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title ? `${title} · Current Law` : "Current Law"}</title>
  <meta name="description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Source+Serif+4:opsz,wght@8..60,600;8..60,700&display=swap" rel="stylesheet" />
  <link rel="icon" href={`${base}/favicon.ico`} sizes="48x48" />
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  <link rel="icon" href={`${base}/favicon-32.png`} sizes="32x32" type="image/png" />
  <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
  <link rel="manifest" href={`${base}/site.webmanifest`} />
  <meta name="theme-color" content="#0b1d36" />
  <meta property="og:title" content={title ? `${title} · Current Law` : "Current Law"} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL(`${base}/icon-512.png`, Astro.site).href} />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <div class="topbar">
  <div class="flag-rule" aria-hidden="true"></div>
  <header class="site-header">
    <div class="wrap header-inner">
      <a class="brand" href={`${base}/`}>
        <img class="brand-logo" src={`${base}/favicon.svg`} alt="" width="40" height="40" />
        <span class="brand-text"><span>Current Law</span><small>usacurrentlaw.org</small></span>
      </a>
      <button type="button" class="gs-toggle" id="gs-toggle" aria-label="Search" aria-expanded="false" aria-controls="gsearch"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"/><path d="M20 20l-3.5-3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></button>
      <form class="gsearch" id="gsearch" role="search" action={`${base}/search/`} autocomplete="off">
        <label class="sr-only" for="gq">Search the whole site</label>
        <svg class="gs-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"/><path d="M20 20l-3.5-3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        <input id="gq" name="q" type="search" placeholder="Search laws, politicians, orders…" aria-controls="gs-results" aria-expanded="false" />
        <kbd class="gs-kbd" aria-hidden="true">/</kbd>
        <div id="gs-results" class="gs-results" role="listbox" hidden></div>
      </form>
      <nav aria-label="Main">
        {nav.map(([href, label]) => (
          <a href={`${base}${href}`} aria-current={(href === "/" ? path === "/" || path.startsWith("/laws") : path.startsWith(href)) ? "page" : undefined}>{label}</a>
        ))}
      </nav>
      <div class="theme" role="radiogroup" aria-label="Color theme">
        <button type="button" role="radio" data-t="light" title="Light" aria-label="Light"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.5" fill="currentColor"/><g stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8"/></g></svg></button>
        <button type="button" role="radio" data-t="dark" title="Dark" aria-label="Dark"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" fill="currentColor"/></svg></button>
        <button type="button" role="radio" data-t="system" title="Match my device" aria-label="Match my device"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="2" fill="none" stroke="currentColor" stroke-width="2"/><path d="M8 20h8M12 16v4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></button>
      </div>
    </div>
  </header>
  <div class="ticker" id="ticker" hidden>
    <div class="wrap ticker-inner">
      <span class="ticker-label"><span class="live-dot" aria-hidden="true"></span>Politics</span>
      <div class="ticker-viewport" aria-label="Latest politics headlines" role="region">
        <div class="ticker-track" id="ticker-track"></div>
      </div>
      <button type="button" class="ticker-pause" id="ticker-pause" aria-pressed="false" aria-label="Pause headlines" title="Pause headlines"><svg viewBox="0 0 24 24" aria-hidden="true"><path class="i-pause" d="M7 5h3v14H7zM14 5h3v14h-3z" fill="currentColor"/><path class="i-play" d="M8 5l11 7-11 7z" fill="currentColor"/></svg></button>
    </div>
  </div>
  </div>
  <slot name="hero" />
  <main id="main" class="wrap" data-pagefind-body={kind ? "" : undefined}>
    {kind && <span hidden data-pagefind-filter="type" data-pagefind-meta="type">{kind}</span>}
    <slot />
  </main>
  <ChatWidget />
  <footer class="site-footer">
    <div class="wrap footer-inner">
      <div>
        <p class="footer-brand"><img src={`${base}/favicon.svg`} alt="" width="28" height="28" /> Current Law</p>
        <p>Every US federal law since 1973, in plain English: what it does, who voted for it, and who signed it.</p>
      </div>
      <div>
        <p class="footer-h">Explore</p>
        {[...nav, ["/about/", "About"]].map(([href, label]) => <a href={`${base}${href}`}>{label}</a>)}
      </div>
      <div>
        <p class="footer-h">Sources</p>
        <a href="https://www.congress.gov/">Congress.gov</a>
        <a href="https://www.govinfo.gov/">GovInfo</a>
        <a href="https://voteview.com/">Voteview (UCLA)</a>
        <a href="https://www.federalregister.gov/">Federal Register</a>
      </div>
    </div>
    <div class="wrap fine">Plain-language summaries are written by AI and may contain mistakes. Every law links to its official text.</div>
  </footer>
<script>
  // Light / dark / system theme switch.
  const themeBtns = document.querySelectorAll(".theme button");
  const current = () => document.documentElement.dataset.theme || "system";
  const mark = () => themeBtns.forEach((b) => b.setAttribute("aria-checked", String(b.dataset.t === current())));
  themeBtns.forEach((b) => b.addEventListener("click", () => {
    const t = b.dataset.t;
    if (t === "system") delete document.documentElement.dataset.theme; else document.documentElement.dataset.theme = t;
    try { t === "system" ? localStorage.removeItem("theme") : localStorage.setItem("theme", t); } catch (e) {}
    mark();
  }));
  mark();
</script>
<script>
  // Site-wide instant search, powered by the Pagefind index built with the site.
  const base = (import.meta.env.BASE_URL || "/").replace(/\/$/, "");
  const input = document.getElementById("gq");
  const box = document.getElementById("gs-results");
  let pf, timer, active = -1;
  const esc = (s) => String(s ?? "").replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]);
  async function engine() {
    if (!pf) { pf = await import(/* @vite-ignore */ `${base}/pagefind/pagefind.js`); await pf.init(); }
    return pf;
  }
  async function run() {
    const q = input.value.trim();
    if (q.length < 2) { box.hidden = true; input.setAttribute("aria-expanded", "false"); return; }
    const res = await (await engine()).debouncedSearch(q, {}, 120);
    if (!res) return;
    const items = await Promise.all(res.results.slice(0, 7).map((r) => r.data()));
    active = -1;
    box.innerHTML = items.length
      ? items.map((d, i) => `<a role="option" id="gs-${i}" href="${d.url}"><span class="gs-type">${esc(d.meta.type || "Page")}</span><span class="gs-title">${esc(d.meta.title)}</span><span class="gs-ex">${d.excerpt}</span></a>`).join("")
        + `<a class="gs-all" href="${base}/search/?q=${encodeURIComponent(q)}">${res.results.length === 1 ? "Open the search page" : `See all ${res.results.length} results`} →</a>`
      : `<p class="gs-none">No matches for “${esc(q)}”.</p>`;
    box.hidden = false; input.setAttribute("aria-expanded", "true");
  }
  input?.addEventListener("input", () => { clearTimeout(timer); timer = setTimeout(run, 80); });
  input?.addEventListener("focus", () => { engine(); if (input.value.trim().length > 1) run(); });
  input?.addEventListener("keydown", (e) => {
    const links = [...box.querySelectorAll("a")];
    if (e.key === "ArrowDown" || e.key === "ArrowUp") {
      e.preventDefault(); if (!links.length) return;
      active = (active + (e.key === "ArrowDown" ? 1 : -1) + links.length) % links.length;
      links.forEach((l, i) => l.classList.toggle("on", i === active));
      input.setAttribute("aria-activedescendant", links[active].id || "");
    } else if (e.key === "Enter" && active >= 0) { e.preventDefault(); links[active].click(); }
    else if (e.key === "Escape") { box.hidden = true; input.blur(); }
  });
  document.addEventListener("click", (e) => { if (!e.target.closest(".gsearch")) box.hidden = true; });
  document.addEventListener("keydown", (e) => {
    const typing = /INPUT|TEXTAREA|SELECT/.test(document.activeElement?.tagName);
    if ((e.key === "/" && !typing) || ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k")) { e.preventDefault(); input.focus(); }
  });
</script>
<script>
  // Phone: the search box opens from a button to keep the pinned header short.
  const gsToggle = document.getElementById("gs-toggle");
  gsToggle.addEventListener("click", () => {
    const on = document.querySelector(".topbar").classList.toggle("searching");
    gsToggle.setAttribute("aria-expanded", String(on));
    if (on) document.getElementById("gq").focus();
  });
  // Keep --topbar-h equal to the pinned header's height, for other sticky bars.
  const topbar = document.querySelector(".topbar");
  new ResizeObserver(() => document.documentElement.style.setProperty("--topbar-h", topbar.offsetHeight + "px")).observe(topbar);
  // Politics headline ticker, fed by the site's /api/headlines worker.
  const ticker = document.getElementById("ticker");
  const track = document.getElementById("ticker-track");
  const pause = document.getElementById("ticker-pause");
  try { if (localStorage.getItem("tickerPaused") === "1") ticker.classList.add("paused"); } catch (e) {}
  pause.addEventListener("click", () => {
    const on = ticker.classList.toggle("paused");
    pause.setAttribute("aria-pressed", String(on));
    pause.setAttribute("aria-label", on ? "Play headlines" : "Pause headlines");
    try { localStorage.setItem("tickerPaused", on ? "1" : "0"); } catch (e) {}
  });
  fetch("/api/headlines").then((r) => (r.ok ? r.json() : null)).then((d) => {
    const items = d && Array.isArray(d.items) ? d.items : [];
    if (!items.length) return;
    const make = (h, hidden) => {
      const a = document.createElement("a");
      a.href = h.link; a.target = "_blank"; a.rel = "noopener noreferrer";
      if (hidden) { a.tabIndex = -1; a.setAttribute("aria-hidden", "true"); }
      const src = document.createElement("span"); src.className = "ticker-src"; src.textContent = h.source;
      a.append(src, document.createTextNode(h.title));
      return a;
    };
    // Two copies side by side make the loop seamless.
    items.forEach((h) => track.append(make(h, false)));
    items.forEach((h) => track.append(make(h, true)));
    ticker.hidden = false;
    requestAnimationFrame(() => track.style.setProperty("--dur", Math.max(40, track.scrollWidth / 2 / 70) + "s"));
  }).catch(() => {});
</script>
</body>
</html>

<style is:global>
  :root {
    --bg: #f5f3ee;
    --surface: #ffffff;
    --surface-2: #eeebe3;
    --text: #15171c;
    --muted: #5b5e68;
    --border: #e1ddd3;
    --accent: #1d4ed8;
    --navy: #0b1d36;
    --navy-2: #13294b;
    --gold: #c8a24a;
    --rep: #d42a3a;
    --dem: #1e5fd1;
    --ind: #7a55c2;
    --neutral-bg: #dedbd3;
    --alert-bg: #fff4d1; --alert-fg: #6b4a00; --alert-border: #ecc65a;
    --yea: #15803d;
    --nay: #c0262d;
    --radius: 16px;
    --shadow: 0 1px 2px rgb(16 24 40 / .05), 0 6px 20px rgb(16 24 40 / .06);
    --shadow-lg: 0 2px 4px rgb(16 24 40 / .06), 0 18px 40px rgb(16 24 40 / .12);
    --serif: "Source Serif 4", Georgia, serif;
    --sans: Inter, system-ui, -apple-system, "Segoe UI", sans-serif;
    color-scheme: light;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --bg: #0d1117; --surface: #161b24; --surface-2: #1f2633; --text: #eef0f4; --muted: #a2a9b8;
      --border: #2a3242; --accent: #8fb4ff; --neutral-bg: #3a4150; --alert-bg: #3a2f12; --alert-fg: #f6d77d; --alert-border: #6b5a22; --yea: #4ade80; --nay: #f87171;
      --navy: #08121f; --navy-2: #0f1f38;
      color-scheme: dark;
    }
  }
  :root[data-theme="dark"] {
    --bg: #0d1117; --surface: #161b24; --surface-2: #1f2633; --text: #eef0f4; --muted: #a2a9b8;
    --border: #2a3242; --accent: #8fb4ff; --neutral-bg: #3a4150; --alert-bg: #3a2f12; --alert-fg: #f6d77d; --alert-border: #6b5a22; --yea: #4ade80; --nay: #f87171;
    --navy: #08121f; --navy-2: #0f1f38;
    color-scheme: dark;
  }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; scroll-padding-top: calc(var(--topbar-h, 110px) + 12px); }
  body { margin: 0; background: var(--bg); color: var(--text); font: 16px/1.6 var(--sans); -webkit-font-smoothing: antialiased; }
  a { color: var(--accent); text-underline-offset: 3px; }
  h1, h2, h3 { font-family: var(--serif); line-height: 1.15; margin: 0 0 .5rem; letter-spacing: -.01em; }
  h1 { font-size: clamp(1.9rem, 4.4vw, 3rem); }
  h2 { font-size: clamp(1.35rem, 2.4vw, 1.75rem); margin-top: 2.5rem; }
  .wrap { max-width: 1160px; margin: 0 auto; padding: 0 16px; }
  main.wrap { padding-top: 32px; padding-bottom: 64px; min-height: 60vh; }
  .skip { position: absolute; left: -999px; }
  .skip:focus { left: 16px; top: 8px; background: var(--surface); padding: 8px; z-index: 10; }
  .flag-rule { height: 4px; background: linear-gradient(90deg, var(--dem) 0 33.3%, #fff 33.3% 66.6%, var(--rep) 66.6%); }
  .topbar { position: sticky; top: 0; z-index: 20; background: var(--navy); box-shadow: 0 6px 20px rgb(0 0 0 / .18); }
  .site-header { background: var(--navy); color: #fff; border-bottom: 1px solid rgb(255 255 255 / .08); }
  .ticker { background: var(--navy-2); color: #fff; border-bottom: 1px solid rgb(255 255 255 / .08); font-size: .86rem; }
  .ticker-inner { display: flex; align-items: center; gap: 12px; height: 36px; }
  .ticker-label { flex: none; display: inline-flex; align-items: center; gap: 7px; font-size: .68rem; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; color: var(--gold); }
  .live-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--rep); box-shadow: 0 0 0 0 rgb(212 42 58 / .6); animation: pulse 2s infinite; }
  @keyframes pulse { 70% { box-shadow: 0 0 0 7px rgb(212 42 58 / 0); } 100% { box-shadow: 0 0 0 0 rgb(212 42 58 / 0); } }
  .ticker-viewport { flex: 1; min-width: 0; overflow: hidden; mask-image: linear-gradient(90deg, transparent, #000 24px, #000 calc(100% - 24px), transparent); }
  .ticker-track { display: flex; width: max-content; animation: tick var(--dur, 120s) linear infinite; }
  .ticker:hover .ticker-track, .ticker:focus-within .ticker-track, .ticker.paused .ticker-track { animation-play-state: paused; }
  @keyframes tick { to { transform: translateX(-50%); } }
  .ticker-track a { display: inline-flex; align-items: center; gap: 8px; padding: 0 22px 0 0; color: rgb(255 255 255 / .9); text-decoration: none; white-space: nowrap; }
  .ticker-track a::after { content: "◆"; color: rgb(255 255 255 / .25); font-size: .55rem; margin-left: 14px; }
  .ticker-track a:hover { color: #fff; text-decoration: underline; }
  .ticker-src { font-size: .66rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--navy); background: rgb(255 255 255 / .85); border-radius: 4px; padding: 1px 6px; }
  .ticker-pause { flex: none; width: 26px; height: 26px; display: grid; place-items: center; border: 1px solid rgb(255 255 255 / .2); border-radius: 999px; background: transparent; color: rgb(255 255 255 / .8); cursor: pointer; }
  .ticker-pause svg { width: 12px; height: 12px; }
  .ticker-pause .i-play, .ticker.paused .ticker-pause .i-pause { display: none; }
  .ticker.paused .ticker-pause .i-play { display: inline; }
  @media (prefers-reduced-motion: reduce) { .ticker-track { animation: none; } .ticker-viewport { overflow-x: auto; mask-image: none; } }

  .header-inner { display: flex; align-items: center; justify-content: space-between; gap: 16px 28px; min-height: 66px; flex-wrap: wrap; padding-top: 6px; padding-bottom: 6px; }
  .brand { display: flex; align-items: center; gap: 12px; color: #fff; text-decoration: none; }
  .brand-text { display: flex; flex-direction: column; line-height: 1.05; }
  .brand-text span { font: 700 1.3rem var(--serif); letter-spacing: -.01em; }
  .brand-text small { font-size: .7rem; letter-spacing: .14em; text-transform: uppercase; color: var(--gold); margin-top: 3px; }
  .brand-mark { display: grid; place-items: center; width: 38px; height: 38px; border-radius: 10px; font: 700 1.3rem var(--serif); background: linear-gradient(135deg, var(--dem), var(--rep)); color: #fff; box-shadow: inset 0 0 0 1px rgb(255 255 255 / .25); }
  .brand-mark.small { width: 26px; height: 26px; font-size: .95rem; border-radius: 7px; display: inline-grid; vertical-align: middle; }
  nav { display: flex; gap: 2px; flex-wrap: wrap; }
  .theme { display: inline-flex; gap: 2px; padding: 3px; border-radius: 999px; background: rgb(255 255 255 / .08); border: 1px solid rgb(255 255 255 / .12); }
  .theme button { width: 30px; height: 30px; display: grid; place-items: center; border: 0; border-radius: 999px; background: transparent; color: rgb(255 255 255 / .7); cursor: pointer; }
  .theme button svg { width: 16px; height: 16px; }
  .theme button:hover { color: #fff; }
  .theme button[aria-checked="true"] { background: #fff; color: var(--navy); }
  .gsearch { position: relative; flex: 1 1 220px; max-width: 380px; order: 3; }
  @media (min-width: 1100px) { .gsearch { order: 0; } }
  .gsearch input[type="search"] { width: 100%; padding: 10px 40px 10px 40px; border-radius: 999px; border: 1px solid rgb(255 255 255 / .16); background: rgb(255 255 255 / .08); color: #fff; }
  .gsearch input::placeholder { color: rgb(255 255 255 / .6); }
  .gsearch input[type="search"]:focus { background: #fff; color: var(--navy); outline: 3px solid color-mix(in srgb, var(--gold) 60%, transparent); }
  .gsearch input:focus::placeholder { color: #667; }
  .gs-icon { position: absolute; left: 14px; top: 50%; width: 17px; height: 17px; transform: translateY(-50%); color: rgb(255 255 255 / .7); pointer-events: none; }
  .gsearch:focus-within .gs-icon { color: var(--navy); }
  .gs-kbd { position: absolute; right: 12px; top: 50%; transform: translateY(-50%); font: 600 .72rem var(--sans); color: rgb(255 255 255 / .6); border: 1px solid rgb(255 255 255 / .25); border-radius: 6px; padding: 1px 7px; }
  .gsearch:focus-within .gs-kbd { display: none; }
  .gs-results { position: absolute; top: calc(100% + 8px); left: 0; right: 0; min-width: min(520px, 92vw); background: var(--surface); color: var(--text); border: 1px solid var(--border); border-radius: 14px; box-shadow: var(--shadow-lg); padding: 6px; z-index: 30; max-height: 70vh; overflow: auto; }
  .gs-results a { display: grid; grid-template-columns: auto 1fr; gap: 2px 10px; padding: 10px 12px; border-radius: 10px; text-decoration: none; color: inherit; }
  .gs-results a:hover, .gs-results a.on { background: var(--surface-2); }
  .gs-type { grid-row: span 2; align-self: start; font-size: .64rem; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; color: #fff; background: var(--navy-2); border-radius: 6px; padding: 3px 7px; margin-top: 2px; }
  .gs-title { font-weight: 600; }
  .gs-ex { font-size: .82rem; color: var(--muted); overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
  .gs-ex mark, .sr-list mark { background: color-mix(in srgb, var(--gold) 40%, transparent); color: inherit; border-radius: 3px; padding: 0 2px; }
  .gs-results a.gs-all { display: block; text-align: center; font-weight: 600; color: var(--accent); border-top: 1px solid var(--border); border-radius: 0 0 10px 10px; margin-top: 4px; }
  .gs-none { margin: 0; padding: 14px; color: var(--muted); }
  nav a { padding: 8px 12px; border-radius: 999px; color: rgb(255 255 255 / .78); text-decoration: none; font-weight: 500; font-size: .93rem; transition: background .15s, color .15s; }
  nav a:hover { background: rgb(255 255 255 / .08); color: #fff; }
  nav a[aria-current="page"] { color: var(--navy); background: #fff; }
  .site-footer { background: var(--navy); color: rgb(255 255 255 / .72); font-size: .92rem; padding: 48px 0 28px; margin-top: 24px; }
  .footer-inner { display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 32px; }
  @media (max-width: 720px) { .footer-inner { grid-template-columns: 1fr 1fr; } .footer-inner > div:first-child { grid-column: 1 / -1; } }
