---
import Base from "../layouts/Base.astro";
import LawCard from "../components/LawCard.astro";
import { allLaws, congressLabel } from "../lib/data.js";
const laws = allLaws();
const presidents = [...new Map(laws.filter((l) => l.president).map((l) => [l.president.id, l.president])).values()];
const congresses = [...new Set(laws.map((l) => l.congress))].sort((a, b) => b - a);
const topics = [...new Set(laws.map((l) => l.policy_area).filter(Boolean))].sort();
const recorded = laws.filter((l) => l.recorded_vote).length;
const PAGE = 50;
---
<Base>
  <section class="hero">
    <h1>Every federal law, in plain English.</h1>
    <p class="lede">See what each law does, how every member of Congress voted, and which President signed it.</p>
    <div class="legend" aria-label="Color key">
      <span class="sw" style="background:hsl(216 72% 40%)"></span>Passed mostly by Democrats
      <span class="sw" style="background:hsl(356 72% 40%)"></span>Passed mostly by Republicans
      <span class="sw" style="background:var(--neutral-bg)"></span>No recorded vote
      <span class="muted">Darker means more one-sided.</span>
    </div>
  </section>

  <form class="filters card" role="search" onsubmit="return false">
    <label class="sr-only" for="q">Search laws</label>
    <input id="q" type="search" placeholder="Search by name, topic, or bill number" autocomplete="off" />
    <select id="side" aria-label="Passed by">
      <option value="">Passed by anyone</option>
      <option value="D">Mostly Democrats</option>
      <option value="R">Mostly Republicans</option>
      <option value="partyline">One party only</option>
      <option value="none">No recorded vote</option>
    </select>
    <select id="president" aria-label="President">
      <option value="">Any President</option>
      {presidents.map((p) => <option value={p.id}>{p.name}</option>)}
    </select>
    <select id="congress" aria-label="Congress">
      <option value="">Any Congress</option>
      {congresses.map((c) => <option value={c}>{congressLabel(c)}</option>)}
    </select>
    <select id="topic" aria-label="Topic">
      <option value="">Any topic</option>
      {topics.map((t) => <option value={t}>{t}</option>)}
    </select>
  </form>
  <p class="muted count"><span id="shown">{laws.length}</span> of {laws.length} laws · {recorded} had recorded votes; the rest passed by voice vote or unanimous consent.</p>

  <div class="grid" id="laws">
    {laws.slice(0, PAGE).map((law) => <LawCard law={law} />)}
  </div>
  <p id="empty" class="muted" hidden>No laws match those filters.</p>
  <button id="more" class="more-btn" type="button" hidden={laws.length <= PAGE}>Show more laws</button>
</Base>

<script>
  // The first page of laws is in the HTML. Everything else (and all searching)
  // uses a compact index fetched on first interaction, so the page stays small.
  const PAGE = 50;
  const base = (import.meta.env.BASE_URL || "/").replace(/\/$/, "");
  const $ = (id) => document.getElementById(id);
  const list = $("laws");
  let rows = null, matches = null, shown = 0;
  const esc = (s) => String(s).replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]);

  async function load() {
    if (!rows) rows = await (await fetch(`${base}/laws-index.json`)).json();
    return rows;
  }
  function card(r) {
    const [id, title, pl, date, topic, headline, side, presId, presName, congress, recorded, bg, fg, passed, partyLine, control] = r;
    return `<a class="law-card card" href="${base}/laws/${id}/">
      <span class="stripe" style="background:${bg}" aria-hidden="true"></span>
      <div class="body">
        <div class="meta muted"><span>Public Law ${esc(pl)}</span><span>·</span><span>${esc(date)}</span>${topic ? `<span>·</span><span>${esc(topic)}</span>` : ""}</div>
        <h3>${esc(title)}</h3>
        ${headline ? `<p class="headline">${esc(headline)}</p>` : ""}
        <div class="tags">
          <span class="pill" style="background:${bg};color:${fg}">${esc(passed)}</span>
          ${partyLine ? `<span class="pill alert">⚠ ${esc(partyLine)}</span>` : ""}
          ${presName ? `<span class="pill">Signed by ${esc(presName)}</span>` : `<span class="pill alert">Became law over a veto</span>`}
          ${control ? `<span class="pill">${esc(control)}</span>` : ""}
        </div>
      </div></a>`;
  }
  function render(reset) {
    if (reset) { list.innerHTML = ""; shown = 0; }
    const next = matches.slice(shown, shown + PAGE);
    list.insertAdjacentHTML("beforeend", next.map(card).join(""));
    shown += next.length;
    $("shown").textContent = matches.length;
    $("empty").hidden = matches.length > 0;
    $("more").hidden = shown >= matches.length;
  }
  async function apply() {
    await load();
    const q = $("q").value.trim().toLowerCase().split(/\s+/).filter(Boolean);
    const side = $("side").value, pres = $("president").value, cong = $("congress").value, topic = $("topic").value;
    matches = rows.filter((r) => {
      const text = `${r[1]} ${r[16]} ${r[2]} ${r[4]} ${r[5]}`.toLowerCase();
      return q.every((w) => text.includes(w))
        && (!side || (side === "partyline" ? r[14] : side === "none" ? !r[10] : r[6] === side))
        && (!pres || r[7] === pres) && (!cong || String(r[9]) === cong) && (!topic || r[4] === topic);
    });
    render(true);
  }
  for (const id of ["q", "side", "president", "congress", "topic"]) $(id).addEventListener("input", apply);
  $("more").addEventListener("click", async () => { if (!matches) { await load(); matches = rows; shown = list.children.length; } render(false); });
</script>
<style is:global>
  #laws .law-card { display: flex; overflow: hidden; text-decoration: none; color: inherit; }
  #laws .stripe { width: 8px; flex: none; }
  #laws .body { padding: 14px 16px; min-width: 0; }
  #laws .meta { display: flex; gap: 6px; flex-wrap: wrap; font-size: .8rem; }
  #laws h3 { font-size: 1.08rem; margin: 4px 0 6px; overflow-wrap: anywhere; }
  #laws .headline { margin: 0 0 10px; color: var(--muted); }
  #laws .tags { display: flex; gap: 6px; flex-wrap: wrap; }
</style>

<style>
  .hero { padding: 12px 0 20px; }
  .lede { font-size: 1.15rem; color: var(--muted); max-width: 640px; margin: 0 0 16px; }
  .legend { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 14px; font-size: .88rem; }
  .sw { display: inline-block; width: 14px; height: 14px; border-radius: 4px; margin-right: -8px; }
  .filters { display: grid; grid-template-columns: minmax(200px, 2fr) repeat(4, minmax(150px, 1fr)); gap: 8px; padding: 12px; position: sticky; top: 68px; z-index: 4; }
  @media (max-width: 860px) { .filters { grid-template-columns: 1fr 1fr; position: static; } .filters input { grid-column: 1 / -1; } }
  .count { font-size: .88rem; margin: 12px 2px; }
  .more-btn { display: block; margin: 20px auto 0; font: 600 1rem var(--sans); padding: 12px 22px; border-radius: 10px; border: 1px solid var(--border); background: var(--surface); color: var(--text); cursor: pointer; }
  .more-btn:hover { background: var(--surface-2); }
  .more-btn[hidden] { display: none; }
</style>
