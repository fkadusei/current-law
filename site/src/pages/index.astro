---
import Base from "../layouts/Base.astro";
import LawCard from "../components/LawCard.astro";
import FailedCard from "../components/FailedCard.astro";
import { allFailed, allLaws, executiveOrders, congressLabel, partyLineLabel, formatDate, lawColor, passedByLabel } from "../lib/data.js";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const laws = allLaws();
const presidents = [...new Map(laws.filter((l) => l.president).map((l) => [l.president.id, l.president])).values()];
const congresses = [...new Set(laws.map((l) => l.congress))].sort((a, b) => b - a);
const topics = [...new Set(laws.map((l) => l.policy_area).filter(Boolean))].sort();
const recorded = laws.filter((l) => l.recorded_vote).length;
const partyLine = laws.filter((l) => partyLineLabel(l));
const totalVotes = laws.reduce((n, l) => n + l.votes.reduce((m, v) => m + v.members.length, 0), 0);
const eos = executiveOrders();
const failed = allFailed();
const firstYear = Math.min(...laws.map((l) => +l.enacted.slice(0, 4)));
const PAGE = 50;
// Per-Congress breakdown for the chart.
const byCongress = [...congresses].reverse().map((c) => {
  const ls = laws.filter((l) => l.congress === c);
  const d = ls.filter((l) => l.party_color?.side === "D").length;
  const r = ls.filter((l) => l.party_color?.side === "R").length;
  const other = ls.length - d - r;
  return { c, total: ls.length, d, r, other, start: 1789 + 2 * (c - 1),
    president: [...new Set(ls.filter((l) => l.president).map((l) => l.president.name))].join(" / ") };
});
const maxTotal = Math.max(...byCongress.map((b) => b.total));
const fmt = (n) => n.toLocaleString("en-US");
// Front page: the newest law with a recorded vote leads; the next newest laws fill the side rail.
const lead = laws.find((l) => l.recorded_vote && l.party_color && l.summary?.headline) || laws[0];
const leadColor = lawColor(lead.party_color);
const leadBody = (lead.summary?.what_it_does || "").length > 340 ? lead.summary.what_it_does.slice(0, 337).replace(/\s+\S*$/, "") + "…" : (lead.summary?.what_it_does || "");
const rail = laws.filter((l) => l !== lead).slice(0, 5);
---
<Base>
  <section slot="hero" class="front">
    <div class="wrap">
      <div class="front-intro">
        <p class="eyebrow-label">United States federal law · {firstYear}–today</p>
        <h1>Every law Congress passes, <em>in plain English.</em></h1>
        <p class="lede">What each law does, how every Representative and Senator voted, and which President signed it, with the party behind every vote in red and blue.</p>
        <form class="hero-search" role="search" onsubmit="event.preventDefault(); document.getElementById('browse').scrollIntoView(); document.getElementById('q').value = this.hq.value; document.getElementById('q').dispatchEvent(new Event('input'));">
          <label class="sr-only" for="hq">Search laws</label>
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"/><path d="M20 20l-3.5-3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          <input id="hq" name="hq" type="search" placeholder="Search laws: “veterans”, “tax”, “H.R. 2882”…" />
          <button type="submit">Search</button>
        </form>
      </div>

      <div class="front-grid">
        <article class="lead" style={`--lc:${leadColor.bg};--lf:${leadColor.fg}`}>
          <p class="kicker"><span>Latest law with a recorded vote</span>{lead.policy_area && <span class="k-topic">{lead.policy_area}</span>}</p>
          <h2><a href={`${base}/laws/${lead.id}/`}>{lead.title}</a></h2>
          {lead.summary?.headline && <p class="dek">{lead.summary.headline}</p>}
          {leadBody && <p class="lead-body">{leadBody}</p>}
          {lead.party_color && (
            <div class="lead-meter" aria-label={`Yes votes: ${lead.party_color.d_yeas} Democratic, ${lead.party_color.r_yeas} Republican`}>
              {lead.party_color.d_yeas > 0 && <span class="ym-d" style={`flex:${lead.party_color.d_yeas}`}>{lead.party_color.d_yeas} D yes</span>}
              {lead.party_color.r_yeas > 0 && <span class="ym-r" style={`flex:${lead.party_color.r_yeas}`}>{lead.party_color.r_yeas} R yes</span>}
            </div>
          )}
          <div class="lead-tags">
            <span class="pill" style={`background:${leadColor.bg};color:${leadColor.fg}`}>{passedByLabel(lead)}</span>
            {partyLineLabel(lead) && <span class="pill alert ico-alert">{partyLineLabel(lead)}</span>}
            {lead.president && <span class={`pill signer ico-pen p-${lead.president.party[0]}`}>Signed by {lead.president.name}</span>}
          </div>
          <p class="byline">{formatDate(lead.enacted)} · Public Law {lead.public_law} · <a href={`${base}/laws/${lead.id}/`}>Read the full story →</a></p>
        </article>

        <aside class="rail" aria-labelledby="rail-h">
          <h3 id="rail-h" class="rail-h">Just signed into law</h3>
          <ol>
            {rail.map((l) => (
              <li>
                <a href={`${base}/laws/${l.id}/`}>
                  <span class="r-meta"><i style={`background:${lawColor(l.party_color).bg}`}></i>{formatDate(l.enacted)}{l.president ? ` · ${l.president.name}` : ""}</span>
                  <strong>{l.title.length > 90 ? l.title.slice(0, 87) + "…" : l.title}</strong>
                </a>
              </li>
            ))}
          </ol>
          <a class="rail-all" href={`${base}/#browse`}>All {fmt(laws.length)} laws →</a>
        </aside>
      </div>

      <dl class="stats">
        <a class="stat-link" href={`${base}/#browse`} data-side=""><dd>{fmt(laws.length)}</dd><dt>Laws explained</dt></a>
        <a class="stat-link" href={`${base}/politicians/`}><dd>{fmt(totalVotes)}</dd><dt>Individual votes recorded</dt></a>
        <a class="stat-link" href={`${base}/?side=partyline#browse`} data-side="partyline"><dd>{fmt(partyLine.length)}</dd><dt>Passed by one party alone</dt></a>
        <a class="stat-link" href={`${base}/executive-orders/`}><dd>{fmt(eos.length)}</dd><dt>Executive orders</dt></a>
      </dl>
    </div>
  </section>

  <section class="chart card" aria-labelledby="chart-h">
    <div class="chart-head">
      <div>
        <h2 id="chart-h">Who passed the laws, Congress by Congress</h2>
        <p class="muted">Each column is one two-year Congress. Click one to see its laws.</p>
      </div>
      <div class="legend">
        <span><i style="background:var(--dem)"></i>Mostly Democratic votes</span>
        <span><i style="background:var(--rep)"></i>Mostly Republican votes</span>
        <span><i class="hatch"></i>Voice vote or even split</span>
      </div>
    </div>
    <div class="cols">
      {byCongress.map((b) => (
        <button type="button" class="col" data-congress={b.c} title={`${congressLabel(b.c)}: ${b.d} Democratic-majority, ${b.r} Republican-majority, ${b.other} voice vote or even`}>
          <span class="stack" style={`height:${(b.total / maxTotal) * 100}%`}>
            <span class="seg-d" style={`flex:${b.d}`}></span>
            <span class="seg-r" style={`flex:${b.r}`}></span>
            <span class="seg-o" style={`flex:${b.other}`}></span>
          </span>
          <span class="col-total">{b.total}</span>
          <span class="col-label">{b.start}–{String(b.start + 1).slice(2)}</span>
          <span class="col-pres">{b.president}</span>
        </button>
      ))}
    </div>
  </section>

  {partyLine.length > 0 && (
    <section aria-labelledby="pl-h">
      <div class="section-head">
        <h2 id="pl-h">Passed by one party alone</h2>
        <p class="muted">Laws where not a single member of the other party voted yes.</p>
      </div>
      <div class="spot">
        {partyLine.slice(0, 6).map((l) => (
          <a class={`spot-card side-${l.party_color.side}`} href={`${base}/laws/${l.id}/`}>
            <span class="spot-badge">{partyLineLabel(l)}</span>
            <strong>{l.title.length > 110 ? l.title.slice(0, 107) + "…" : l.title}</strong>
            <span class="spot-meta">{formatDate(l.enacted)} · {l.party_color.side === "D" ? l.party_color.d_yeas : l.party_color.r_yeas} yes votes</span>
          </a>
        ))}
      </div>
    </section>
  )}

  {failed.length > 0 && (
    <section aria-labelledby="nf-h">
      <div class="section-head">
        <h2 id="nf-h">Recently failed in Congress</h2>
        <p class="muted">Bills and resolutions that lost a floor vote. <a href={`${base}/did-not-pass/`}>See all {fmt(failed.length)} →</a></p>
      </div>
      <div class="grid">{failed.slice(0, 3).map((item) => <FailedCard item={item} />)}</div>
    </section>
  )}

  <section id="browse" aria-labelledby="browse-h">
    <div class="section-head">
      <h2 id="browse-h">Browse every law</h2>
      <p class="muted">{fmt(laws.length)} laws since 2013. For {fmt(recorded)} of them, Congress recorded how each member voted. The other {fmt(laws.length - recorded)} passed by voice vote or unanimous consent, so no individual votes exist. Those are shown in gray.</p>
    </div>
    <form class="filters card" role="search" onsubmit="return false">
      <label class="sr-only" for="q">Search laws</label>
      <input id="q" type="search" placeholder="Filter by name, topic, or bill number" autocomplete="off" />
      <select id="side" aria-label="Passed by">
        <option value="">Passed by anyone</option>
        <option value="D">Mostly Democrats</option>
        <option value="R">Mostly Republicans</option>
        <option value="partyline">One party only</option>
        <option value="none">No recorded vote</option>
      </select>
      <select id="president" aria-label="President">
        <option value="">Any President</option>
        {presidents.map((p) => <option value={p.id}>{p.name}{p.id === "trump-1" ? " (1st term)" : p.id === "trump-2" ? " (2nd term)" : ""}</option>)}
      </select>
      <select id="congress" aria-label="Congress">
        <option value="">Any Congress</option>
        {congresses.map((c) => <option value={c}>{congressLabel(c)}</option>)}
      </select>
      <select id="topic" aria-label="Topic">
        <option value="">Any topic</option>
        {topics.map((t) => <option value={t}>{t}</option>)}
      </select>
    </form>
    <p class="muted count"><span id="shown">{laws.length}</span> laws</p>
    <div class="grid" id="laws">
      {laws.slice(0, PAGE).map((law) => <LawCard law={law} />)}
    </div>
    <p id="empty" class="muted" hidden>No laws match those filters.</p>
    <button id="more" class="more-btn" type="button" hidden={laws.length <= PAGE}>Show more laws</button>
  </section>
</Base>
<script>
  // The first page of laws is in the HTML. Everything else (and all searching)
  // uses a compact index fetched on first interaction, so the page stays small.
  const PAGE = 50;
  const base = (import.meta.env.BASE_URL || "/").replace(/\/$/, "");
  const $ = (id) => document.getElementById(id);
  const list = $("laws");
  let rows = null, matches = null, shown = 0;
  const esc = (s) => String(s).replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]);

  async function load() {
    if (!rows) rows = await (await fetch(`${base}/laws-index.json`)).json();
    return rows;
  }
  function card(r) {
    const [id, title, pl, date, topic, headline, side, presId, presName, congress, recorded, bg, fg, passed, partyLine, control, bill, dy, ry, presParty, ctl] = r;
    return `<a class="law-card card" href="${base}/laws/${id}/">
      <span class="stripe" style="background:${bg}" aria-hidden="true"></span>
      <div class="body">
        <div class="meta">${topic ? `<span class="topic">${esc(topic)}</span>` : ""}<span class="muted">Public Law ${esc(pl)} · ${esc(date)}</span></div>
        <h3>${esc(title)}</h3>
        ${headline ? `<p class="headline">${esc(headline)}</p>` : ""}
        <div class="tags">
          <span class="pill" style="background:${bg};color:${fg}">${esc(passed)}</span>
          ${partyLine ? `<span class="pill alert ico-alert">${esc(partyLine)}</span>` : ""}
          ${presName ? `<span class="pill signer ico-pen p-${presParty}">Signed by ${esc(presName)}</span>` : `<span class="pill alert">Became law over a veto</span>`}
          ${Object.entries(ctl).map(([ch, p]) => `<span class="pill ghost ctl"><i class="dot-${p}"></i>${p === "R" ? "Republican" : "Democratic"} ${ch}</span>`).join("")}
        </div>
      </div>${dy + ry ? `<div class="yes-split"><span class="ys-label">Yes votes · ${Object.keys(ctl).length > 1 ? "House + Senate" : Object.keys(ctl)[0] + " only"}</span><span class="ys-bar">${dy ? `<span class="d" style="flex:${dy}"></span>` : ""}${ry ? `<span class="r" style="flex:${ry}"></span>` : ""}</span><span class="ys-nums"><b class="party-D">${dy} D</b><b class="party-R">${ry} R</b></span></div>` : ""}</a>`;
  }
  function render(reset) {
    if (reset) { list.innerHTML = ""; shown = 0; }
    const next = matches.slice(shown, shown + PAGE);
    list.insertAdjacentHTML("beforeend", next.map(card).join(""));
    shown += next.length;
    $("shown").textContent = matches.length;
    $("empty").hidden = matches.length > 0;
    $("more").hidden = shown >= matches.length;
  }
  async function apply() {
    await load();
    const q = $("q").value.trim().toLowerCase().split(/\s+/).filter(Boolean);
    const side = $("side").value, pres = $("president").value, cong = $("congress").value, topic = $("topic").value;
    matches = rows.filter((r) => {
      const text = `${r[1]} ${r[16]} ${r[2]} ${r[4]} ${r[5]}`.toLowerCase();
      return q.every((w) => text.includes(w))
        && (!side || (side === "partyline" ? r[14] : side === "none" ? !r[10] : r[6] === side))
        && (!pres || r[7] === pres) && (!cong || String(r[9]) === cong) && (!topic || r[4] === topic);
    });
    render(true);
  }
  for (const id of ["q", "side", "president", "congress", "topic"]) $(id).addEventListener("input", apply);
  // Hero stat tiles: jump to the list with the matching filter.
  const pickSide = (v) => { $("side").value = v; apply(); };
  for (const a of document.querySelectorAll(".stat-link[data-side]")) a.addEventListener("click", (e) => {
    e.preventDefault(); pickSide(a.dataset.side);
    history.replaceState(null, "", a.getAttribute("href"));
    $("browse").scrollIntoView({ behavior: "smooth" });
  });
  const startSide = new URLSearchParams(location.search).get("side");
  if (startSide && [...$("side").options].some((o) => o.value === startSide)) pickSide(startSide);
  for (const col of document.querySelectorAll(".col")) col.addEventListener("click", () => {
    $("congress").value = col.dataset.congress; apply();
    document.getElementById("browse").scrollIntoView({ behavior: "smooth" });
  });
  $("more").addEventListener("click", async () => { if (!matches) { await load(); matches = rows; shown = list.children.length; } render(false); });
</script>

<style>
  .front { background: var(--paper); border-bottom: 1px solid var(--border); padding: 44px 0 0; }
  .front-intro { text-align: center; max-width: 860px; margin: 0 auto; }
  .front h1 { font-size: clamp(2.4rem, 6vw, 4.6rem); line-height: 1.02; letter-spacing: -.035em; margin: 12px 0 16px; }
  .front h1 em { font-style: italic; font-weight: 600; color: var(--rep); }
  .lede { font-size: 1.15rem; color: var(--muted); max-width: 640px; margin: 0 auto 26px; }
  .hero-search { display: flex; align-items: center; gap: 8px; max-width: 620px; margin: 0 auto; background: var(--surface); padding: 6px 6px 6px 16px; border-radius: 999px; border: 1px solid var(--border); box-shadow: 0 10px 30px rgb(16 24 40 / .08); transition: box-shadow .15s, border-color .15s; }
  .hero-search svg { width: 18px; height: 18px; flex: none; color: var(--muted); }
  .hero-search:focus-within { border-color: var(--text); box-shadow: 0 10px 30px rgb(16 24 40 / .12); }
  .hero-search input { flex: 1 1 0; border: 0; background: transparent; color: var(--text); font-size: 1.05rem; padding: 10px 6px; outline: none; min-width: 0; }
  .hero-search button { border: 0; border-radius: 999px; padding: 11px 24px; font: 700 .95rem var(--sans); color: var(--paper); background: var(--text); cursor: pointer; transition: background .15s; }
  .hero-search button:hover { background: var(--rep); color: #fff; }

  .front-grid { display: grid; grid-template-columns: minmax(0, 1.75fr) minmax(0, 1fr); gap: 0; margin-top: 48px; border-top: 2px solid var(--text); }
  @media (max-width: 900px) { .front-grid { grid-template-columns: minmax(0, 1fr); } }
  .lead { padding: 26px 36px 30px 0; border-right: 1px solid var(--border); }
  @media (max-width: 900px) { .lead { padding: 22px 0 26px; border-right: 0; border-bottom: 1px solid var(--border); } }
  .kicker { display: flex; flex-wrap: wrap; gap: 4px 12px; margin: 0 0 10px; font-size: .7rem; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; color: var(--rep); }
  .k-topic { color: var(--muted); }
  .lead h2 { font-size: clamp(1.9rem, 3.8vw, 3rem); line-height: 1.05; letter-spacing: -.03em; margin: 0 0 14px; }
  .lead h2 a { color: inherit; text-decoration: none; }
  .lead h2 a:hover { text-decoration: underline; text-decoration-thickness: 2px; }
  .dek { font: 500 1.28rem/1.4 var(--serif); color: var(--text); margin: 0 0 12px; }
  .lead-body { color: var(--muted); margin: 0 0 18px; }
  .lead-meter { display: flex; gap: 3px; height: 26px; border-radius: 6px; overflow: hidden; font-size: .76rem; font-weight: 700; color: #fff; margin-bottom: 12px; }
  .lead-meter span { display: flex; align-items: center; padding: 0 10px; white-space: nowrap; overflow: hidden; min-width: 0; }
  .ym-d { background: var(--dem); } .ym-r { background: var(--rep); justify-content: flex-end; }
  .lead-tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .byline { margin: 16px 0 0; font-size: .84rem; color: var(--muted); }
  .byline a { font-weight: 700; color: var(--text); }
  .rail { padding: 26px 0 30px 32px; }
  @media (max-width: 900px) { .rail { padding: 22px 0 26px; } }
  .rail-h { font: 800 .72rem var(--sans); letter-spacing: .14em; text-transform: uppercase; margin: 0 0 6px; color: var(--text); }
  .rail ol { list-style: none; margin: 0; padding: 0; counter-reset: r; }
  .rail li { border-bottom: 1px solid var(--border); counter-increment: r; }
  .rail li a { display: grid; grid-template-columns: 34px 1fr; padding: 14px 0; color: inherit; text-decoration: none; }
  .rail li a::before { content: counter(r); grid-row: span 2; font: 700 1.6rem/1 var(--serif); color: var(--border); }
  .rail li a:hover strong { text-decoration: underline; }
  .r-meta { display: flex; align-items: center; gap: 7px; font-size: .74rem; color: var(--muted); margin-bottom: 3px; }
  .r-meta i { width: 9px; height: 9px; border-radius: 50%; flex: none; }
  .rail strong { font: 600 1.04rem/1.3 var(--serif); }
  .rail-all { display: inline-block; margin-top: 14px; font-weight: 700; font-size: .88rem; color: var(--text); }

  .stats { display: grid; grid-template-columns: repeat(4, 1fr); margin: 0; border-top: 1px solid var(--text); }
  @media (max-width: 720px) { .stats { grid-template-columns: 1fr 1fr; } }
  .stats .stat-link { display: flex; flex-direction: column; gap: 2px; padding: 20px 20px 22px; text-decoration: none; color: inherit; border-left: 1px solid var(--border); transition: background .15s; }
  .stats .stat-link:first-child { border-left: 0; padding-left: 0; }
  @media (max-width: 720px) { .stats .stat-link:nth-child(odd) { border-left: 0; padding-left: 0; } .stats .stat-link:nth-child(n+3) { border-top: 1px solid var(--border); } }
  .stats .stat-link:hover dd { color: var(--rep); }
  .stats dd { margin: 0; font: 700 clamp(1.8rem, 3.4vw, 2.6rem)/1.05 var(--serif); letter-spacing: -.02em; font-variant-numeric: lining-nums tabular-nums; transition: color .15s; }
  .stats dt { font-size: .72rem; color: var(--muted); text-transform: uppercase; letter-spacing: .1em; font-weight: 700; }
  .chart { padding: 26px 28px 20px; margin-top: 8px; }
  .chart-head { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; align-items: flex-end; }
  .chart-head h2 { margin: 0 0 4px; }
  .chart-head p { margin: 0; }
  .legend { display: flex; gap: 14px; flex-wrap: wrap; font-size: .82rem; color: var(--muted); }
  .legend i { display: inline-block; width: 12px; height: 12px; border-radius: 3px; margin-right: 6px; vertical-align: -1px; }
  .legend i.hatch, .seg-o { background: repeating-linear-gradient(135deg, var(--neutral-bg) 0 4px, color-mix(in srgb, var(--neutral-bg) 45%, var(--surface)) 4px 8px) !important; }
  .cols { display: flex; align-items: flex-end; justify-content: space-around; gap: 10px; height: 280px; margin-top: 30px; padding-bottom: 54px; overflow-x: auto; background: linear-gradient(var(--border), var(--border)) 0 calc(100% - 54px) / 100% 1px no-repeat, repeating-linear-gradient(0deg, transparent 0 56px, color-mix(in srgb, var(--border) 60%, transparent) 56px 57px) 0 0 / 100% calc(100% - 54px) no-repeat; }
  .col { flex: 0 1 88px; min-width: 56px; height: 100%; display: flex; flex-direction: column; justify-content: flex-end; align-items: stretch; background: none; border: 0; padding: 0; cursor: pointer; position: relative; font: inherit; color: inherit; }
  .stack { display: flex; flex-direction: column-reverse; border-radius: 8px 8px 0 0; overflow: hidden; transition: transform .15s, filter .15s; }
  .col:hover .stack, .col:focus-visible .stack { transform: translateY(-4px); filter: saturate(1.2); }
  .seg-d { background: var(--dem); } .seg-r { background: var(--rep); } .seg-o { background: var(--neutral-bg); }
  .col-total { position: absolute; top: -2px; left: 0; right: 0; text-align: center; font-weight: 700; font-size: .82rem; color: var(--muted); font-variant-numeric: tabular-nums; transform: translateY(-100%); }
  .col-label { position: absolute; bottom: -24px; left: 0; right: 0; text-align: center; font-weight: 700; font-size: .82rem; }
  .col-pres { position: absolute; bottom: -44px; left: -6px; right: -6px; text-align: center; font-size: .68rem; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .section-head { display: flex; justify-content: space-between; align-items: baseline; gap: 6px 20px; flex-wrap: wrap; margin: 56px 0 18px; padding-top: 14px; border-top: 2px solid var(--text); }
  .section-head h2 { margin: 0; }
