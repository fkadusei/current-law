---
import Base from "../layouts/Base.astro";
import { allLaws, executiveOrders, SUPPORT_URL } from "../lib/data.js";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const laws = allLaws(), eos = executiveOrders();
const first = laws.reduce((a, l) => (l.enacted && l.enacted < a ? l.enacted : a), "9999").slice(0, 4);
const voted = laws.filter((l) => l.recorded_vote).length;
---
<Base title="About">
  <section slot="hero" class="page-hero"><div class="wrap"><p class="eyebrow-label">About this site</p><h1>Every federal law, in plain English</h1><p>Who voted for it, who signed it, and what it means for you. Built from official public records.</p></div></section>
  <div class="about">
  <article class="card pad prose">
    <p class="lead">Current Law shows every US federal law since 1973: what it does in plain English, how each member of the House and Senate voted, and which President signed it. It also lists executive orders, which a President issues without a vote in Congress.</p>
    <h2>How the colors work</h2>
    <p>Each law is colored by the party that supplied most of its "yes" votes, counting the House and Senate together. <span class="party-D"><strong>Blue</strong></span> means most yes votes came from Democrats; <span class="party-R"><strong>red</strong></span> means most came from Republicans. The darker the color, the more one-sided the vote: the lightest shade is close to an even split, and the darkest means only one party voted yes.</p>
    <p>This can differ from which party controlled Congress, so each law shows both. For example, a law can be labeled "Republican House" but "Passed by a Democratic majority."</p>
    <p>When not a single member of one party voted yes, the law carries a yellow warning badge saying so.</p>
    <p>Gray laws passed by voice vote or unanimous consent. Congress kept no record of how individual members voted on them. Most ceremonial laws, like naming a post office, pass this way.</p>
    <h2>Where the data comes from</h2>
    <ul>
      <li><a href="https://www.congress.gov/">Congress.gov</a> and <a href="https://www.govinfo.gov/">GovInfo</a>: laws, official summaries, sponsors and full text.</li>
      <li><a href="https://voteview.com/">Voteview</a> (UCLA): every House and Senate roll-call vote.</li>
      <li><a href="https://www.federalregister.gov/">The Federal Register</a>: executive orders from 1994 on.</li>
    </ul>
    <h2>About the summaries</h2>
    <p>Plain-language summaries are written by AI from the official Congressional Research Service summary, and are labeled that way. They can contain mistakes. Every law links to its official text.</p>
    <h2>Known limits</h2>
    <ul>
      <li>Votes are matched to the final passage vote in each chamber. When the House passes a Senate bill's contents under different bill numbers, the House vote may be missing.</li>
      <li>Independents are counted with Democrats when deciding which party controlled a chamber, since almost all of them caucused with Democrats.</li>
    </ul>
  </article>
  <aside class="card pad facts">
    <h2>On the site now</h2>
    <dl>
      <div><dt>{laws.length.toLocaleString()}</dt><dd>laws, {first} to today</dd></div>
      <div><dt>{voted.toLocaleString()}</dt><dd>with a full roll-call vote record</dd></div>
      <div><dt>{eos.length.toLocaleString()}</dt><dd>executive orders since 1994</dd></div>
    </dl>
    <p class="muted small">Laws from 1973 to {Number(first) - 1} are being added.</p>
    {SUPPORT_URL && (
      <div class="support">
        <strong>Keep it free</strong>
        <p>No ads and no paywall. Reader tips pay for the AI summaries and the assistant.</p>
        <a class="btn gold" href={SUPPORT_URL} target="_blank" rel="noopener">♥ Support Current Law</a>
      </div>
    )}
    <div class="cta">
      <a class="btn" href={`${base}/calendar/`}>Browse by date</a>
      <a class="btn ghost" href={`${base}/presidents/`}>Browse by President</a>
    </div>
  </aside>
  </div>
</Base>
<style>
  .pad { padding: 24px; }
  .about { display: grid; grid-template-columns: minmax(0, 760px) 300px; gap: 20px; align-items: start; }
  @media (max-width: 960px) { .about { grid-template-columns: 1fr; } }
  .facts { position: sticky; top: 96px; }
  .facts h2 { margin: 0 0 10px; font-size: 1.15rem; }
  .facts dl { margin: 0; display: grid; gap: 12px; }
  .facts dl div { padding-bottom: 10px; border-bottom: 1px solid var(--border); }
  .facts dt { font-size: 1.6rem; font-weight: 800; line-height: 1.1; }
  .facts dd { margin: 2px 0 0; color: var(--muted); font-size: .9rem; }
  .small { font-size: .85rem; }
  .cta { display: flex; flex-direction: column; gap: 8px; margin-top: 12px; }
  .btn { display: block; text-align: center; padding: 10px 14px; border-radius: 10px; font-weight: 700; text-decoration: none; background: var(--navy); color: #fff; }
  .support { margin-top: 14px; padding: 14px; border-radius: 12px; background: var(--surface-2); }
  .support p { margin: 4px 0 10px; font-size: .88rem; color: var(--muted); }
  .btn.gold { background: var(--gold); color: var(--navy); }
  .btn.ghost { background: var(--surface-2); color: var(--text); }
  .prose { max-width: 760px; }
  .prose h2 { margin-top: 1.6rem; }
  .prose h2:first-of-type { margin-top: 1.2rem; }
  .lead { font-size: 1.1rem; margin-top: 0; }
</style>
