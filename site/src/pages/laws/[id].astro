---
import Base from "../../layouts/Base.astro";
import VoteBreakdown from "../../components/VoteBreakdown.astro";
import { allLaws, lawColor, passedByLabel, controlLabel, partyLineLabel, formatDate, congressLabel, PARTY_NAME } from "../../lib/data.js";
export function getStaticPaths() {
  return allLaws().map((law) => ({ params: { id: law.id }, props: { law } }));
}
const { law } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const color = lawColor(law.party_color);
const s = law.summary;
const partyLine = partyLineLabel(law);
const textLink = law.text_links?.find((l) => l.url?.endsWith(".pdf")) || law.text_links?.[0];
const officialText = (law.official_summary || "").replace(/<[^>]+>/g, " ").replace(/&nbsp;/g, " ").replace(/\s+/g, " ").trim();
const zero = law.party_color?.zero_yeas_by_chamber || {};
const zeroNotes = Object.entries(zero).flatMap(([ch, ps]) => ps.map((p) => `No ${p === "R" ? "Republican" : "Democrat"} in the ${ch} voted yes`));
---
<Base title={law.title} kind="Law" description={s?.headline || law.title}>
  <section slot="hero" class="law-hero" style={`--lc:${color.bg};--lf:${color.fg}`}>
    <div class="wrap">
      <p class="crumbs"><a href={`${base}/`}>Laws</a> › {congressLabel(law.congress)}</p>
      <p class="eyebrow">Public Law {law.public_law} · {law.bill} · {formatDate(law.enacted)}{law.policy_area ? ` · ${law.policy_area}` : ""}</p>
      <h1>{law.title}</h1>
      <div class="hero-tags">
        <span class="verdict">{passedByLabel(law)}</span>
        {partyLine && <span class="oneparty">⚠ {partyLine}</span>}
        {law.president
          ? <a class={`signer-chip p-${law.president.party[0]}`} href={`${base}/presidents/${law.president.id}/`}>✍ Signed by {law.president.name}</a>
          : <span class="verdict">Became law over the President's veto</span>}
        {Object.entries(law.control || {}).map(([ch, p]) => <span class={`ctl-chip p-${p}`}>{p === "R" ? "Republican" : "Democratic"} {ch}</span>)}
      </div>
      {law.party_color && (
        <div class="yes-meter" aria-label={`Yes votes: ${law.party_color.d_yeas} Democratic, ${law.party_color.r_yeas} Republican`}>
          {law.party_color.d_yeas > 0 && <span class="ym-d" style={`flex:${law.party_color.d_yeas}`}>{`${law.party_color.d_yeas} Democratic yes`}</span>}
          {law.party_color.r_yeas > 0 && <span class="ym-r" style={`flex:${law.party_color.r_yeas}`}>{`${law.party_color.r_yeas} Republican yes`}</span>}
        </div>
      )}
    </div>
  </section>
  <article>
    {(partyLine || zeroNotes.length > 0) && (
      <div class="alert-box" role="note">
        <strong>⚠ {partyLine ?? "One-party vote in one chamber"}</strong>
        <ul>{zeroNotes.map((n) => <li>{n}</li>)}</ul>
      </div>
    )}

    <div class="layout">
      <div class="main-col">
        <section class="card pad">
          <h2>What it does</h2>
          {s ? (
            <>
              <p class="headline">{s.headline}</p>
              <p>{s.what_it_does}</p>
              {s.who_it_affects?.length > 0 && (
                <>
                  <h3>Who it affects</h3>
                  <ul class="affects">{s.who_it_affects.map((a) => <li><strong>{a.group}:</strong> {a.how}</li>)}</ul>
                </>
              )}
              {s.when_it_takes_effect && <p><strong>When:</strong> {s.when_it_takes_effect}</p>}
              <p class="ai-note muted">Written by AI from the official summary{s.confidence === "low" ? " (limited source material, so treat with care)" : ""}. Check the official text below.</p>
            </>
          ) : officialText ? (
            <>
              <p class="muted small">A plain-language summary is coming. Here is the official summary from the Congressional Research Service:</p>
              {officialText.length > 900
                ? <details class="official"><summary>{officialText.slice(0, 600)}… <span class="more">Read the full official summary</span></summary><p>{officialText}</p></details>
                : <p>{officialText}</p>}
            </>
          ) : <p class="muted">No summary yet. See the official text below.</p>}
        </section>

        <h2>How Congress voted</h2>
        {law.votes.length > 0
          ? <div class="grid">{law.votes.map((v, i) => <VoteBreakdown vote={v} index={i} />)}</div>
          : <p class="card pad">This law passed by voice vote or unanimous consent, so there is no record of how individual members voted.</p>}
      </div>

      <aside class="side-col" data-pagefind-ignore>
        <div class="card pad facts">
          <h3>At a glance</h3>
          <dl>
            <dt>Became law</dt>
            <dd>{law.president
              ? <><a class={`signer-chip p-${law.president.party[0]}`} href={`${base}/presidents/${law.president.id}/`}>✍ {law.president.name}</a><span class="muted"> {law.president.party} · signed {formatDate(law.enacted)}</span></>
              : <>Passed over the President's veto on {formatDate(law.enacted)}</>}</dd>
            {law.sponsor && <><dt>Sponsor</dt><dd>{law.sponsor}</dd></>}
            {law.policy_area && <><dt>Topic</dt><dd>{law.policy_area}</dd></>}
            {law.party_color && <><dt>Yes votes by party</dt><dd><span class="party-D">{law.party_color.d_yeas} Democratic</span> · <span class="party-R">{law.party_color.r_yeas} Republican</span></dd></>}
          </dl>
          <h3>Official sources</h3>
          <ul class="links">
            <li><a href={law.congress_gov_url} rel="noopener">Congress.gov page</a></li>
            {textLink && <li><a href={textLink.url} rel="noopener">Full text of the law</a></li>}
          </ul>
        </div>
      </aside>
    </div>
  </article>
</Base>
<style>
  .law-hero { color: #fff; padding: 36px 0 34px; background: radial-gradient(900px 300px at 100% 0%, color-mix(in srgb, var(--lc) 70%, transparent), transparent 70%), linear-gradient(180deg, var(--navy), var(--navy-2)); border-bottom: 6px solid var(--lc); }
  .law-hero .crumbs { font-size: .85rem; margin: 0 0 18px; color: rgb(255 255 255 / .7); }
  .law-hero .crumbs a { color: #fff; }
  .law-hero h1 { color: #fff; max-width: 900px; overflow-wrap: anywhere; }
  .eyebrow { font-size: .82rem; margin: 0 0 10px; color: var(--gold); font-weight: 600; letter-spacing: .02em; }
  .hero-tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 16px; }
  .verdict { background: var(--lc); color: var(--lf); font-weight: 700; padding: 6px 14px; border-radius: 999px; }
  .ctl-chip { padding: 6px 12px; border-radius: 999px; font-weight: 600; font-size: .9rem; border: 1px solid rgb(255 255 255 / .25); }
  .ctl-chip::before { content: ""; display: inline-block; width: 9px; height: 9px; border-radius: 50%; margin-right: 7px; }
  .ctl-chip.p-D::before { background: #6ea0ff; } .ctl-chip.p-R::before { background: #ff6b78; }
  .oneparty { display: inline-flex; align-items: center; padding: 8px 14px; border-radius: 999px; font-weight: 700; font-size: .9rem; background: #fff3c4; color: #5a4300; box-shadow: 0 0 0 2px #e8b931; }
  .yes-meter { display: flex; gap: 3px; margin-top: 22px; max-width: 760px; height: 30px; border-radius: 10px; overflow: hidden; font-size: .8rem; font-weight: 700; }
  .yes-meter span { display: flex; align-items: center; padding: 0 10px; white-space: nowrap; overflow: hidden; min-width: 0; }
  .ym-d { background: var(--dem); } .ym-r { background: var(--rep); justify-content: flex-end; }
  .alert-box { border: 2px solid var(--alert-border); background: var(--alert-bg); color: var(--alert-fg); border-radius: var(--radius); padding: 12px 16px; margin-bottom: 16px; }
  .alert-box ul { margin: 6px 0 0; padding-left: 20px; }
  .layout { display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: 20px; align-items: start; }
  @media (max-width: 860px) { .layout { grid-template-columns: 1fr; } }
  .official summary { cursor: pointer; list-style: none; }
  .official[open] summary { display: none; }
  .more { color: var(--accent); font-weight: 600; white-space: nowrap; }
  .pad { padding: 18px; }
  .main-col h2:first-child { margin-top: 0; }
  .headline { font-size: 1.12rem; font-weight: 600; }
  .affects { padding-left: 20px; }
  .ai-note, .small { font-size: .85rem; }
  .facts dl { margin: 0 0 12px; }
  .facts dt { font-size: .78rem; text-transform: uppercase; letter-spacing: .04em; color: var(--muted); margin-top: 10px; }
  .facts dd { margin: 2px 0 0; }
  .links { padding-left: 18px; margin: 0; }
  .signer-chip { display: inline-block; color: #fff; font-weight: 700; text-decoration: none; padding: 5px 12px; border-radius: 999px; margin: 2px 6px 4px 0; }
  .signer-chip.p-D { background: var(--dem); } .signer-chip.p-R { background: var(--rep); }
</style>
