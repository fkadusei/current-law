---
import Base from "../../layouts/Base.astro";
import VoteBreakdown from "../../components/VoteBreakdown.astro";
import { allLaws, lawColor, passedByLabel, controlLabel, partyLineLabel, formatDate, congressLabel, PARTY_NAME } from "../../lib/data.js";
export function getStaticPaths() {
  return allLaws().map((law) => ({ params: { id: law.id }, props: { law } }));
}
const { law } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const color = lawColor(law.party_color);
const s = law.summary;
const partyLine = partyLineLabel(law);
const textLink = law.text_links?.find((l) => l.url?.endsWith(".pdf")) || law.text_links?.[0];
const officialText = (law.official_summary || "").replace(/<[^>]+>/g, " ").replace(/&nbsp;/g, " ").replace(/\s+/g, " ").trim();
const zero = law.party_color?.zero_yeas_by_chamber || {};
const zeroNotes = Object.entries(zero).flatMap(([ch, ps]) => ps.map((p) => `No ${p === "R" ? "Republican" : "Democrat"} in the ${ch} voted yes`));
---
<Base title={law.title} description={s?.headline || law.title}>
  <p class="crumbs muted"><a href={`${base}/`}>Laws</a> › {congressLabel(law.congress)}</p>
  <article>
    <div class="banner" style={`background:${color.bg};color:${color.fg}`}>
      <p class="eyebrow">Public Law {law.public_law} · {law.bill} · {formatDate(law.enacted)}</p>
      <h1>{law.title}</h1>
      <p class="passed">{passedByLabel(law)}</p>
      {controlLabel(law) && <p class="control">Congress at the time: {controlLabel(law)}</p>}
    </div>
    {(partyLine || zeroNotes.length > 0) && (
      <div class="alert-box" role="note">
        <strong>⚠ {partyLine ?? "One-party vote in one chamber"}</strong>
        <ul>{zeroNotes.map((n) => <li>{n}</li>)}</ul>
      </div>
    )}

    <div class="layout">
      <div class="main-col">
        <section class="card pad">
          <h2>What it does</h2>
          {s ? (
            <>
              <p class="headline">{s.headline}</p>
              <p>{s.what_it_does}</p>
              {s.who_it_affects?.length > 0 && (
                <>
                  <h3>Who it affects</h3>
                  <ul class="affects">{s.who_it_affects.map((a) => <li><strong>{a.group}:</strong> {a.how}</li>)}</ul>
                </>
              )}
              {s.when_it_takes_effect && <p><strong>When:</strong> {s.when_it_takes_effect}</p>}
              <p class="ai-note muted">Written by AI from the official summary{s.confidence === "low" ? " (limited source material, so treat with care)" : ""}. Check the official text below.</p>
            </>
          ) : officialText ? (
            <>
              <p class="muted small">A plain-language summary is coming. Here is the official summary from the Congressional Research Service:</p>
              {officialText.length > 900
                ? <details class="official"><summary>{officialText.slice(0, 600)}… <span class="more">Read the full official summary</span></summary><p>{officialText}</p></details>
                : <p>{officialText}</p>}
            </>
          ) : <p class="muted">No summary yet. See the official text below.</p>}
        </section>

        <h2>How Congress voted</h2>
        {law.votes.length > 0
          ? <div class="grid">{law.votes.map((v, i) => <VoteBreakdown vote={v} index={i} />)}</div>
          : <p class="card pad">This law passed by voice vote or unanimous consent, so there is no record of how individual members voted.</p>}
      </div>

      <aside class="side-col">
        <div class="card pad facts">
          <h3>At a glance</h3>
          <dl>
            <dt>Became law</dt>
            <dd>{law.president
              ? <>Signed by <a href={`${base}/presidents/${law.president.id}/`}>{law.president.name}</a> ({law.president.party}) on {formatDate(law.enacted)}</>
              : <>Passed over the President's veto on {formatDate(law.enacted)}</>}</dd>
            {law.sponsor && <><dt>Sponsor</dt><dd>{law.sponsor}</dd></>}
            {law.policy_area && <><dt>Topic</dt><dd>{law.policy_area}</dd></>}
            {law.party_color && <><dt>Yes votes by party</dt><dd><span class="party-D">{law.party_color.d_yeas} Democratic</span> · <span class="party-R">{law.party_color.r_yeas} Republican</span></dd></>}
          </dl>
          <h3>Official sources</h3>
          <ul class="links">
            <li><a href={law.congress_gov_url} rel="noopener">Congress.gov page</a></li>
            {textLink && <li><a href={textLink.url} rel="noopener">Full text of the law</a></li>}
          </ul>
        </div>
      </aside>
    </div>
  </article>
</Base>
<style>
  .crumbs { font-size: .88rem; margin: 0 0 12px; }
  .banner { border-radius: var(--radius); padding: 24px; margin-bottom: 16px; }
  .banner a { color: inherit; }
  .eyebrow { font-size: .85rem; margin: 0 0 8px; opacity: .85; }
  .banner h1 { overflow-wrap: anywhere; }
  .passed { font-size: 1.15rem; font-weight: 700; margin: 8px 0 2px; }
  .control { margin: 0; opacity: .9; }
  .alert-box { border: 2px solid #e8c766; background: #fff8e1; color: #5c4300; border-radius: var(--radius); padding: 12px 16px; margin-bottom: 16px; }
  @media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) .alert-box { background: #2e2710; color: #f3d77a; border-color: #6b5a22; } }
  .alert-box ul { margin: 6px 0 0; padding-left: 20px; }
  .layout { display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: 20px; align-items: start; }
  @media (max-width: 860px) { .layout { grid-template-columns: 1fr; } }
  .official summary { cursor: pointer; list-style: none; }
  .official[open] summary { display: none; }
  .more { color: var(--accent); font-weight: 600; white-space: nowrap; }
  .pad { padding: 18px; }
  .main-col h2:first-child { margin-top: 0; }
  .headline { font-size: 1.12rem; font-weight: 600; }
  .affects { padding-left: 20px; }
  .ai-note, .small { font-size: .85rem; }
  .facts dl { margin: 0 0 12px; }
  .facts dt { font-size: .78rem; text-transform: uppercase; letter-spacing: .04em; color: var(--muted); margin-top: 10px; }
  .facts dd { margin: 2px 0 0; }
  .links { padding-left: 18px; margin: 0; }
</style>
